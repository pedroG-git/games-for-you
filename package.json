{
  "name": "games-for-you",
  "version": "1.6.1",
  "private": true,
  "description": "Games for you - offline Android game collection",
  "scripts": {
    "version-file": "node scripts/write-version.js",
    "version": "node scripts/write-version.js && git add docs/version.json",
    "sync": "node scripts/write-version.js && cap sync android",
    "serve": "node scripts/write-version.js && node scripts/serve.js",
    "test": "node tools/test-levelgen.js 30 && node tools/test-dragon.js 20 && node tools/test-mahjong.js 30"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3"
  }
}
